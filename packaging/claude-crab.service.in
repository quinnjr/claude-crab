[Unit]
Description=Clawd walking above your panel while Claude Code works
Documentation=https://github.com/quinnjr/claude-crab
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CLAUDE_CRAB_BINARY@
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=graphical-session.target
