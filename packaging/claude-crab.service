[Unit]
Description=Clawd walking above your panel while Claude Code works
Documentation=https://github.com/quinnjr/claude-crab
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Absolute path so systemd does not depend on the unit's PATH. A --user install
# to somewhere under $HOME wants this pointed at that prefix instead.
ExecStart=/usr/bin/claude-crab
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=graphical-session.target
